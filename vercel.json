{
    "version": 2,
    "outputDirectory": "public",
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.9.0"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/assets/(.*\\.css)",
            "dest": "/public/assets/$1",
            "headers": {
                "Content-Type": "text/css"
            }
        },
        {
            "src": "/assets/(.*\\.js)",
            "dest": "/public/assets/$1",
            "headers": {
                "Content-Type": "application/javascript"
            }
        },
        {
            "src": "/assets/(.*)",
            "dest": "/public/assets/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}