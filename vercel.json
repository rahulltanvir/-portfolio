{
    "version": 2,
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.9.0"
        }
    ],
    "routes": [
        {
            "src": "/assets/(.*)",
            "continue": true
        },
        {
            "src": "/(.*)",
            "dest": "api/index.php"
        }
    ]
}